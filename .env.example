# ⚠️  JUS OBRIGAÇÕES MASTER — Configuração
# Copie este arquivo para .env e preencha as chaves desejadas.
# NUNCA commite o .env no repositório!

# ============================================================
# 🔐 CHAVES DE API (configure ao menos uma para usar IA)
# ============================================================

# Groq (RECOMENDADO) → grátis, rápido, sem cota limitada
# Crie sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek → muito barato (R$0,50/milhão de tokens)
DEEPSEEK_API_KEY=

# OpenRouter → acesso a vários modelos (alguns gratuitos)
OPENROUTER_API_KEY=

# Gemini → cota gratuita limitada
GEMINI_API_KEY=

# Qwen / Mistral → via OpenRouter (requer chave do OpenRouter)
QWEN_API_KEY=
MISTRAL_API_KEY=

# ============================================================
# 🎛️  CONFIGURAÇÃO DA IA
# ============================================================

# Provedor Ativo (auto-detecção se deixar vazio):
# Opções: gemini, openrouter, deepseek, qwen, mistral, offline
ACTIVE_PROVIDER=

# Temperatura da IA (0.1 a 1.0) — menor = mais preciso, maior = mais criativo
TEMPERATURE=0.3

# ============================================================
# 🗄️  BANCO DE DADOS
# ============================================================

# URL do banco de dados (SQLite padrão, PostgreSQL em produção)
# Para PostgreSQL use: postgresql://usuario:senha@host:5432/nome_banco
# Para Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///database/jus_obrigacoes.db

# ============================================================
# 🌐  CORS (segurança — configure em produção!)
# ============================================================

# Origens permitidas separadas por vírgula (sem espaços)
# Ex: https://meusite.com,https://www.meusite.com
# Deixe vazio para desenvolvimento local (localhost:5173)
CORS_ORIGINS=

# ============================================================
# 🚦  RATE LIMITING (proteção contra abuso)
# ============================================================

# Máximo de requisições por janela de tempo (por IP + rota)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ============================================================
# 📋  IMPORTANTE: SEGURANÇA EM PRODUÇÃO
# ============================================================
# 1. NUNCA armazene chaves de API no .env de produção com
#    permissões de leitura para outros usuários do sistema
# 2. Em cloud (Render, Railway, etc.), use o painel de Secrets
# 3. Configure CORS_ORIGINS com o domínio exato do seu frontend
# 4. Considere adicionar autenticação (ex: senha mestra) em
#    produção para evitar uso não autorizado da API
# 5. Revogue e recrie a chave Groq se ela foi exposta em logs,
#    prints ou commits
